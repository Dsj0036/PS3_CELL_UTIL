<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|PS3'">
    <LocalDebuggerClearTty>true</LocalDebuggerClearTty>
    <DebuggerFlavor>PS3Debugger</DebuggerFlavor>
    <LocalDebuggerCommandLine>-e -m -r -t</LocalDebuggerCommandLine>
    <LocalRunCommandLine>-t</LocalRunCommandLine>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DontRun|PS3'">
    <LocalDebuggerClearTty>true</LocalDebuggerClearTty>
    <DebuggerFlavor>PS3Debugger</DebuggerFlavor>
  </PropertyGroup>
  <PropertyGroup>
    <ShowAllFiles>true</ShowAllFiles>
  </PropertyGroup>
</Project>